#!/usr/bin/env python3
"""Preview questions that the faculty portal will import from a supported file."""

import argparse
import json
from pathlib import Path

from rag.question_import import parse_question_file


def main() -> None:
    parser = argparse.ArgumentParser(description="Parse a DOCX, XLSX, or CSV question list.")
    parser.add_argument(
        "document",
        nargs="?",
        type=Path,
        default=Path(__file__).resolve().parent / "Question List.docx",
    )
    parser.add_argument("--json", action="store_true", help="Print import-ready JSON.")
    args = parser.parse_args()

    questions = parse_question_file(args.document.read_bytes(), args.document.name)
    if args.json:
        print(json.dumps(questions, indent=2))
        return
    for number, question in enumerate(questions, start=1):
        print(f"QUESTION {number}: {question['question']}")
        for point in question["key_points"]:
            print(f"  KEY POINT: {point}")
        if question.get("follow_up"):
            print(f"  FOLLOW-UP: {question['follow_up']}")


if __name__ == "__main__":
    main()
