# Copy this file to /etc/capstone/capstone.env on the Ubuntu server.
# Paths assume that the repository is cloned to /opt/capstone.

MAIN_PYTHON=/opt/capstone/.venv-tts/bin/python
WAV2LIP_PYTHON=/opt/capstone/.venv-wav2lip/bin/python
STT_PYTHON=/opt/capstone/.venv-stt/bin/python

STT_HOST=127.0.0.1
STT_PORT=8000
RECORDINGS_DIR=/var/lib/capstone/recordings

WHISPER_MODEL=base.en
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

OLLAMA_MODEL=llama3
OLLAMA_HOST=http://127.0.0.1:11434
REFERENCE_AUDIO_PATH=/opt/capstone/text-to-speech-model/Sid.wav
