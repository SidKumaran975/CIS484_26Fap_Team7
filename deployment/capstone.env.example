# Copy this file to /etc/capstone/capstone.env on the Ubuntu server.
# Paths assume that the repository is cloned to /opt/capstone.

MAIN_PYTHON=/opt/capstone/.venv-tts/bin/python
WAV2LIP_PYTHON=/opt/capstone/.venv-wav2lip/bin/python
STT_PYTHON=/opt/capstone/.venv-stt/bin/python

STT_HOST=127.0.0.1
STT_PORT=8000
PORT=8001
RECORDINGS_DIR=/var/lib/capstone/recordings
DB_PATH=/var/lib/capstone/exam_builder.db
FACULTY_DB_PATH=/var/lib/capstone/exam_builder.db
FACULTY_EXAMS_DIR=/var/lib/capstone/exams
FACULTY_COURSE_STORAGE=/var/lib/capstone/faculty-courses
FACULTY_INDEX_STORAGE=/var/lib/capstone/faculty-indexes
SESSION_DB_PATH=/var/lib/capstone/sessions.sqlite3
ANALYTICS_DB_PATH=/var/lib/capstone/analytics.sqlite3
MEDIA_DIR=/var/lib/capstone/media

WHISPER_MODEL=base.en
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
RAG_EMBED_MODEL=nomic-embed-text
EVALUATION_MODEL=qwen2.5:7b
RAG_TOP_K=6
MAX_FOLLOW_UPS=1

# none = text/browser voice, audio = XTTS audio, avatar = XTTS + Wav2Lip
MEDIA_MODE=avatar
REFERENCE_AUDIO_PATH=/opt/capstone/text-to-speech-model/Sid.wav
MEDIA_GENERATION_TIMEOUT=600
# A factor of 2 is faster and usually looks better than feeding a very large image.
WAV2LIP_RESIZE_FACTOR=2

# Estimated non-GPU system draw. Calibrate with a wall meter when accuracy matters.
# NVIDIA GPU draw is sampled separately through nvidia-smi when available.
ANALYTICS_BASE_WATTS=80

MAX_AUDIO_BYTES=20971520
RETAIN_AUDIO=false
